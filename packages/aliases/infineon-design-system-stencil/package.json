{
	"name": "@infineon/infineon-design-system-stencil",
	"version": "42.0.2",
	"description": "Compatibility publication of @infineon/design-system",
	"deprecated": "This package has moved to @infineon/design-system. It remains supported during the migration period; use the new name when migrating.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Infineon/infineon-design-system-stencil.git",
		"directory": "packages/aliases/infineon-design-system-stencil"
	},
	"main": "dist/index.cjs.js",
	"module": "dist/index.js",
	"types": "dist/types/index.d.ts",
	"unpkg": "dist/infineon-design-system-stencil/infineon-design-system-stencil.esm.js",
	"collection": "dist/collection/collection-manifest.json",
	"collection:main": "dist/collection/index.js",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/infineon-design-system-stencil.js",
			"require": "./dist/cjs/infineon-design-system-stencil.cjs.js"
		},
		"./dist/*": {
			"import": "./dist/*",
			"types": "./dist/*"
		},
		"./loader": {
			"types": "./dist/loader/index.d.ts",
			"import": "./dist/loader/index.js",
			"require": "./dist/loader/index.cjs.js"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"default": "./dist/components/index.js"
		},
		"./components/*": {
			"default": "./dist/components/*"
		},
		"./styles.css": "./dist/infineon-design-system-stencil/infineon-design-system-stencil.css"
	},
	"dependencies": {
		"@infineon/design-system-icons": "^5.0.0",
		"@infineon/design-system-tokens": "^7.1.0",
		"@popperjs/core": "^2.11.8",
		"ag-grid-community": "^34.3.1",
		"classnames": "^2.5.1"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepack": "node ../../../scripts/release/stage-legacy.mjs stencil"
	}
}
